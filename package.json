{
  "name": "apk-tvpro",
  "version": "1.0.0",
  "description": "Aplicación para Android TV y Gateway API para TV Pro / Películas",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "server": "tsx watch src/server/server.ts",
    "preview": "vite preview",
    "build:apk": "cd android-app && .\\gradlew.bat assembleRelease",
    "install:apk": "powershell.exe -ExecutionPolicy Bypass -File .\\instalar.ps1"
  },
  "keywords": [
    "tv-pro",
    "android-tv",
    "movies",
    "hls",
    "exoplayer",
    "leanback"
  ],
  "author": "TV Pro Team",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "axios": "^1.7.9",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "hls.js": "^1.5.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
